{
  "Statement": [
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["Update:Replace", "Update:Delete"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ResourceType": [
            "AWS::EC2::Instance",
            "AWS::EC2::Volume",
            "AWS::EC2::VolumeAttachment",
            "AWS::EC2::NetworkInterface",
            "AWS::S3::Bucket",
            "AWS::SecretsManager::Secret",
            "AWS::Route53::HostedZone"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": "*",
      "Action": "Update:*",
      "Resource": "*"
    }
  ]
}
